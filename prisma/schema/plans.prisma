model MealPlanRecord {
  entryId    String    @id @db.Uuid
  title      String
  validFrom  DateTime? @db.Date
  validUntil DateTime? @db.Date
  content    Json
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entry MasterRecordEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
}

model WorkoutPlanRecord {
  entryId    String    @id @db.Uuid
  title      String
  validFrom  DateTime? @db.Date
  validUntil DateTime? @db.Date
  content    Json
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  entry MasterRecordEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
}

model ExerciseLibraryItem {
  id                    String   @id @default(uuid()) @db.Uuid
  moduleId              String   @db.Uuid
  createdByUserId       String   @db.Uuid
  updatedByUserId       String   @db.Uuid
  name                  String
  normalizedName        String   @unique
  muscleGroup           String?
  equipment             String?
  description           String?
  mediaUrl              String?
  valences              Json?
  executionInstructions String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  module    SystemModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdBy User         @relation("ExerciseLibraryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User         @relation("ExerciseLibraryUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([moduleId, active])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}
