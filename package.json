{
  "name": "saulo-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import-foods": "tsx scripts/import-food-database.ts",
    "db:import-ibge-measures": "tsx scripts/import-ibge-household-measures.ts",
    "db:audit-evonut": "tsx scripts/audit-evonut-foods.ts",
    "db:import-evonut": "tsx scripts/import-evonut-foods.ts",
    "db:import-evonut-foods": "tsx scripts/import-evonut-foods.ts",
    "test:food-database": "node --import tsx --test src/features/food-database/taco-xlsx.test.ts",
    "test:ibge-measures": "node --import tsx --test src/features/food-database/ibge-household-measures.test.ts",
    "test:evonut-audit": "node --import tsx --test src/features/food-database/evonut-audit.test.ts",
    "test:evonut-import": "node --import tsx --test src/features/food-database/evonut-import.test.ts",
    "test:authentication": "node --import tsx --test src/features/mvp/session-authentication.test.ts src/features/mvp/authentication-navigation.test.ts src/features/mvp/auth-route-handlers.test.ts",
    "db:studio": "prisma studio",
    "check": "npm run db:validate && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "^17.0.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.10",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "prisma": "7.8.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.10"
  }
}
